{
  "name": "@rekurt/ohlcv-vue",
  "version": "0.0.1",
  "description": "Vue 3 wrapper for @rekurt/ohlcv-core — <OHLCVChart> component and useOHLCVChart composable.",
  "keywords": ["ohlcv", "candlestick", "chart", "vue", "vue3", "trading", "canvas"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rekurt/ohlcv-front.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/rekurt/ohlcv-front/issues"
  },
  "homepage": "https://github.com/rekurt/ohlcv-front#readme",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "@rekurt/ohlcv-core": "*"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "devDependencies": {
    "vue": "^3.5.0"
  }
}
