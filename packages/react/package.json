{
  "name": "@rekurt/ohlcv-react",
  "version": "0.0.1",
  "description": "React 18+/19 wrapper for @rekurt/ohlcv-core — <OHLCVChart> component and useOHLCVChart hook.",
  "keywords": ["ohlcv", "candlestick", "chart", "react", "trading", "canvas"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rekurt/ohlcv-front.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/rekurt/ohlcv-front/issues"
  },
  "homepage": "https://github.com/rekurt/ohlcv-front#readme",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "@rekurt/ohlcv-core": "*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
