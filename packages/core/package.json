{
  "name": "@rekurt/openkline-core",
  "version": "0.1.0",
  "description": "Framework-agnostic OHLCV candlestick chart library. Canvas-based, TypedArray-backed, keyboard-first.",
  "keywords": [
    "ohlcv",
    "candlestick",
    "chart",
    "trading",
    "canvas",
    "typescript",
    "indicators",
    "rsi",
    "bollinger",
    "binance"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rekurt/openkline.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/rekurt/openkline/issues"
  },
  "homepage": "https://github.com/rekurt/openkline#readme",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./indicators": {
      "import": {
        "types": "./dist/indicators.d.ts",
        "default": "./dist/indicators.js"
      },
      "require": {
        "types": "./dist/indicators.d.cts",
        "default": "./dist/indicators.cjs"
      }
    },
    "./drawings": {
      "import": {
        "types": "./dist/drawings.d.ts",
        "default": "./dist/drawings.js"
      },
      "require": {
        "types": "./dist/drawings.d.cts",
        "default": "./dist/drawings.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18.18.0"
  }
}
